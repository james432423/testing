# Copy to .env.local for local development. Never commit real values.
# Every variable here is server-only: none use the NEXT_PUBLIC_ prefix, so
# Next.js never puts them in a browser bundle.

# --- Database -------------------------------------------------------------
# Postgres connection string. On Vercel + Neon use the POOLED url
# (host contains "-pooler") and keep sslmode=require.
DATABASE_URL=postgres://postgres@localhost:5432/ida_dev
# Max connections per serverless instance (default 5).
DATABASE_POOL_MAX=5

# --- Auth.js (NextAuth v5) -----------------------------------------------
# Random 32+ byte secret that encrypts Auth.js cookies/tokens.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Canonical URL of the site. Optional on Vercel (detected automatically);
# set it for local dev and for a custom domain.
AUTH_URL=http://localhost:3000
# Trust the Host header. Vercel sets VERCEL=1 and this is implied there; set
# to true only behind another proxy you control.
AUTH_TRUST_HOST=true

# --- Private beta allowlist ----------------------------------------------
# Comma-separated Google emails allowed to sign in. Removing an email also
# cuts off that person's existing sessions on their next request.
ALLOWED_EMAILS=you@example.com

# --- Action approvals -----------------------------------------------------
# HMAC key that signs every approval the executor accepts. 32+ characters,
# different from AUTH_SECRET. Rotating it invalidates unused approvals only.
# Generate with: openssl rand -hex 32
APPROVAL_SIGNING_SECRET=

# --- Models (OpenRouter-compatible chat completions) --------------------
# mock = no network, deterministic drafts and reviews (default).
# live = call MODEL_API_BASE_URL with MODEL_API_KEY.
MODEL_MODE=mock
MODEL_API_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
# Worker drafts actions; reviewer independently checks them. They MUST be
# different models from different providers (the part before "/"), or the
# server refuses to start.
WORKER_MODEL=mock-worker/drafter
REVIEWER_MODEL=mock-reviewer/checker
# Optional: send reviewer calls to a different gateway/key.
REVIEWER_API_BASE_URL=
REVIEWER_API_KEY=

# --- Tests only -----------------------------------------------------------
# When set, tests create and drop a fresh database per file on this server
# instead of using in-process PGlite. Must point at a database you can
# CREATE DATABASE from (e.g. the "postgres" maintenance db).
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
