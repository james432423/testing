{
  "name": "ida-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "prototype:sync": "node scripts/sync-prototype.mjs",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?set TEST_DATABASE_URL} vitest run"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "drizzle-kit": "0.31.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
